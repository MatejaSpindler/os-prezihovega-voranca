---
import { Camera, Users } from '@lucide/astro';
import SiteHeader from '../components/SiteHeader.astro';
import { supportingLinks } from '../data/links';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'OŠ Prežihovega Voranca Maribor',
  description = 'Obvestila, urniki, jedilnik, dejavnosti in šolske vsebine na enem mestu.',
} = Astro.props;
const fullTitle = title === 'OŠ Prežihovega Voranca Maribor'
  ? title
  : title + ' | OŠ Prežihovega Voranca Maribor';
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16634a" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <SiteHeader />
    <main id="vsebina">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <img src="/images/logo.png" alt="" width="68" height="68" />
          <div><strong>OŠ Prežihovega Voranca Maribor</strong><span>Gosposvetska 10, 2000 Maribor</span></div>
        </div>
        <div class="footer-links">
          {supportingLinks.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
        </div>
        <div class="social-links" aria-label="Družbena omrežja">
          <a href="https://www.instagram.com/ospvmb/" target="_blank" rel="noreferrer" title="Instagram" aria-label="Instagram"><Camera size={21} /></a>
          <a href="https://www.facebook.com/profile.php?id=61552588658829" target="_blank" rel="noreferrer" title="Facebook" aria-label="Facebook"><Users size={21} /></a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} OŠ Prežihovega Voranca Maribor</span>
        <span>Vse šolske vsebine v prenovljeni podobi.</span>
      </div>
    </footer>
  </body>
</html>
